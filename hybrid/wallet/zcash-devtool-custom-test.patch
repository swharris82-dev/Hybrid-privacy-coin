                 })?;
-                Network::Regtest(crate::data::load_activation_heights(path)?)
+                opts.network
+                    .with_heights(crate::data::load_activation_heights(path)?)
             }
-            other => {
+            None => {
                 if opts.activation_heights.is_some() {
                     return Err(anyhow::anyhow!(
