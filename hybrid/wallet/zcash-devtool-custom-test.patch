 src/commands/wallet/init.rs             | 21 +++++++++-------
 src/commands/wallet/restore_mnemonic.rs | 21 +++++++++-------
 src/config.rs                           | 13 ++++------
 src/data.rs                             | 32 +++++++++++++++++++++++++
 src/remote.rs                           |  2 +-
 6 files changed, 71 insertions(+), 28 deletions(-)

diff --git a/src/commands/inspect/block.rs b/src/commands/inspect/block.rs
index 3cb9490..93cb201 100644
--- a/src/commands/inspect/block.rs
+++ b/src/commands/inspect/block.rs
@@ -58,6 +58,9 @@ impl BlockParams for Network {
             Self::Main | Self::Test => 200,
             #[cfg(feature = "regtest_support")]
             Self::Regtest(_) => 48,
+            // Custom test networks use Testnet-sized headers.
+            #[cfg(feature = "regtest_support")]
+            Self::CustomTest(_) => 200,
         }
     }
 
@@ -66,6 +69,8 @@ impl BlockParams for Network {
             Self::Main | Self::Test => 9,
             #[cfg(feature = "regtest_support")]
             Self::Regtest(_) => 5,
+            #[cfg(feature = "regtest_support")]
+            Self::CustomTest(_) => 9,
         }
     }
 
@@ -80,7 +85,10 @@ impl BlockParams for Network {
                     .unwrap(),
             ),
             #[cfg(feature = "regtest_support")]
-            Self::Regtest(_) => U256::from_big_endian(
+            // Custom test networks configure their own limit; the hybrid network uses
+            // the regtest value, which is also the most permissive Zcash limit.
+            #[cfg(feature = "regtest_support")]
+            Self::Regtest(_) | Self::CustomTest(_) => U256::from_big_endian(
                 &hex::decode("0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f")
                     .unwrap(),
             ),
