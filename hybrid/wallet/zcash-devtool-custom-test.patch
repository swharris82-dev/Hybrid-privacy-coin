diff --git a/src/data.rs b/src/data.rs
index ed11ec1..1d10073 100644
--- a/src/data.rs
+++ b/src/data.rs
@@ -32,9 +32,33 @@ pub(crate) enum Network {
     /// but must survive the round-trip distinctly.
     #[cfg(feature = "regtest_support")]
     Regtest(ActivationHeights),
+    /// A custom test network: Testnet address encodings (`utest…`, `tm…`) with the
+    /// caller-chosen activation heights, for private chains such as Lacuna that run as a
+    /// configured Zebra Testnet. Heights are fixed at `init` and persisted, as for regtest.
+    #[cfg(feature = "regtest_support")]
+    CustomTest(ActivationHeights),
 }
 
 impl Network {
+    /// Returns the activation heights carried by a network whose schedule is set at `init`.
+    #[cfg(feature = "regtest_support")]
+    pub(crate) fn configured_heights(&self) -> Option<ActivationHeights> {
+        match self {
+            Network::Regtest(heights) | Network::CustomTest(heights) => Some(*heights),
+            _ => None,
+        }
+    }
+
+    /// Returns this network with `heights` in place of its schedule, if it takes one.
+    #[cfg(feature = "regtest_support")]
+    pub(crate) fn with_heights(self, heights: ActivationHeights) -> Network {
+        match self {
+            Network::Regtest(_) => Network::Regtest(heights),
+            Network::CustomTest(_) => Network::CustomTest(heights),
+            other => other,
+        }
+    }
+
     pub(crate) fn parse(name: &str) -> Result<Network, String> {
         match name {
             "main" => Ok(Network::Main),
@@ -45,6 +69,8 @@ impl Network {
             // (e.g. address encoding) are unaffected by the heights.
             #[cfg(feature = "regtest_support")]
             "regtest" => Ok(Network::Regtest(DEFAULT_REGTEST)),
+            #[cfg(feature = "regtest_support")]
+            "custom-test" => Ok(Network::CustomTest(DEFAULT_REGTEST)),
             other => Err(format!("Unsupported network: {other}")),
         }
     }
